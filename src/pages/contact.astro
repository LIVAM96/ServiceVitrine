---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<html lang="fr">
  <head>
    <Head title="Contact — Demandez un devis gratuit | Mirosotech" description="Contactez Liva Randrianivoson pour votre projet de site vitrine statique. Devis gratuit et sans engagement." />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <Header />

    <section class="py-16 px-6 max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Parlons de votre projet</h2>
        <p class="text-gray-600 text-lg">Un site vitrine pour votre activité ? Une question ? Écrivez-moi.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <ContactForm />
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
          <h3 class="text-xl font-bold mb-6">Mes coordonnées</h3>
          <ul class="space-y-6 text-gray-600">
            <li class="flex items-start gap-4">
              <span class="text-accent font-bold">📧</span>
              <div>
                <p class="font-semibold">Email</p>
                <p class="text-sm">contact@miroso.tech</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-accent font-bold">📱</span>
              <div>
                <p class="font-semibold">Téléphone</p>
                <p class="text-sm">+261 XX XXX XXX</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-accent font-bold">📍</span>
              <div>
                <p class="font-semibold">Localisation</p>
                <p class="text-sm">Madagascar — disponible pour des clients francophones</p>
              </div>
            </li>
          </ul>

          <div class="mt-8 pt-6 border-t border-gray-100">
            <p class="text-sm text-gray-500">
              Réponse sous 24 à 48 heures. Devis gratuit et sans engagement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
