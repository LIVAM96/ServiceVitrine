---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="fr">
  <head>
    <Head title="Nos forfaits de création de site vitrine — Mirosotech" description="Forfaits de création de sites vitrines statiques pour artisans et indépendants." />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <Header />

    <section class="py-16 px-6 max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Mes services</h2>
        <p class="text-gray-600 text-lg">Trois activités pour accompagner votre activité professionnelle.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Sites vitrines -->
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col">
          <h3 class="text-xl font-bold mb-2">🌐 Site vitrine statique</h3>
          <p class="text-2xl font-bold text-accent mb-6">À partir de <span class="text-lg font-normal">600 €</span></p>
          <ul class="space-y-3 mb-8 text-gray-600">
            <li>✅ 3 à 5 pages (Accueil, Services, Contact…)</li>
            <li>✅ Design responsive (mobile)</li>
            <li>✅ Formulaire de contact</li>
            <li>✅ Nom de domaine configuré</li>
            <li>✅ Hébergement statique gratuit</li>
            <li>✅ SEO de base inclus</li>
          </ul>
          <a href="/contact" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold mt-auto hover:bg-gray-800 transition">Choisir ce service</a>
        </div>

        <!-- Transcription -->
        <div class="bg-primary text-white p-8 rounded-xl shadow-sm border border-gray-200 flex flex-col relative">
          <h3 class="text-xl font-bold mb-2">🎙️ Transcription audio</h3>
          <p class="text-2xl font-bold text-accent mb-6">À partir de <span class="text-lg font-normal">1 € / minute</span></p>
          <ul class="space-y-3 mb-8 text-gray-200">
            <li>✅ Fichiers audio (MP3, WAV…)</li>
            <li>✅ Transcription manuelle soignée</li>
            <li>✅ Livraison par email</li>
            <li>✅ Confidentialité garantie</li>
            <li>✅ Suppression des fichiers sur demande</li>
          </ul>
          <a href="/transcription" class="bg-accent text-white px-6 py-3 rounded-lg font-semibold mt-auto hover:bg-blue-700 transition">En savoir plus</a>
        </div>

        <!-- Compte-rendu -->
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col">
          <h3 class="text-xl font-bold mb-2">📋 Compte-rendu de réunion</h3>
          <p class="text-2xl font-bold text-gray-900 mb-6">Devis personnalisé</p>
          <ul class="space-y-3 mb-8 text-gray-600">
            <li>✅ Transcription des échanges</li>
            <li>✅ Synthèse des décisions</li>
            <li>✅ Plan d'actions avec responsables</li>
            <li>✅ Mise en page professionnelle</li>
            <li>✅ Confidentialité garantie</li>
          </ul>
          <a href="/reunion" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold mt-auto hover:bg-gray-800 transition">En savoir plus</a>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
