---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="fr">
  <head>
    <Head title="Nos forfaits de création de site vitrine — Mirosotech" description="Forfaits de création de sites vitrines statiques pour artisans et indépendants. À partir de 600 €." />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <Header />

    <section class="py-16 px-6 max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Nos forfaits</h2>
        <p class="text-gray-600 text-lg">Des solutions simples et adaptées à votre activité.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Starter -->
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col">
          <h3 class="text-xl font-bold mb-2">Starter</h3>
          <p class="text-2xl font-bold text-accent mb-6">À partir de <span class="text-lg font-normal">600 €</span></p>
          <ul class="space-y-3 mb-8 text-gray-600">
            <li>✅ 3 pages (Accueil, Services, Contact)</li>
            <li>✅ Design responsive (mobile)</li>
            <li>✅ Formulaire de contact</li>
            <li>✅ Nom de domaine configuré</li>
            <li>✅ Hébergement statique gratuit</li>
          </ul>
          <a href="/contact" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold mt-auto hover:bg-gray-800 transition">Choisir ce forfait</a>
        </div>

        <!-- Pro -->
        <div class="bg-primary text-white p-8 rounded-xl shadow-sm border border-gray-200 flex flex-col relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-accent text-white px-3 py-1 rounded-full text-xs font-bold">Populaire</span>
          <h3 class="text-xl font-bold mb-2">Pro</h3>
          <p class="text-2xl font-bold text-accent mb-6">À partir de <span class="text-lg font-normal">900 €</span></p>
          <ul class="space-y-3 mb-8 text-gray-200">
            <li>✅ 5 pages (Accueil, Services, À propos, Réalisations, Contact)</li>
            <li>✅ Design responsive (mobile)</li>
            <li>✅ Formulaire de contact</li>
            <li>✅ SEO de base (balises, sitemap, Google Search Console)</li>
            <li>✅ Nom de domaine configuré</li>
            <li>✅ Hébergement statique gratuit</li>
          </ul>
          <a href="/contact" class="bg-accent text-white px-6 py-3 rounded-lg font-semibold mt-auto hover:bg-blue-700 transition">Choisir ce forfait</a>
        </div>

        <!-- Sur mesure -->
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col">
          <h3 class="text-xl font-bold mb-2">Sur mesure</h3>
          <p class="text-2xl font-bold text-gray-900 mb-6">Devis personnalisé</p>
          <ul class="space-y-3 mb-8 text-gray-600">
            <li>✅ Nombre de pages illimité</li>
            <li>✅ Rédaction de vos textes</li>
            <li>✅ Optimisation SEO avancée</li>
            <li>✅ Maintenance annuelle disponible</li>
            <li>✅ Nom de domaine et hébergement</li>
          </ul>
          <a href="/contact" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold mt-auto hover:bg-gray-800 transition">Demander un devis</a>
        </div>
      </div>
    </section>

    <section class="py-16 px-6 max-w-6xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100">
      <div class="text-center mb-10">
        <h3 class="text-2xl font-bold mb-4">Ce qui est inclus dans tous les forfaits</h3>
      </div>
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div>
          <p class="font-bold text-accent">📱 Responsive</p>
          <p class="text-sm text-gray-600 mt-2">Parfait sur téléphone, tablette et ordinateur.</p>
        </div>
        <div>
          <p class="font-bold text-accent">🔍 SEO de base</p>
          <p class="text-sm text-gray-600 mt-2">Balises, URLs propres, indexation Google.</p>
        </div>
        <div>
          <p class="font-bold text-accent">📄 Mentions légales</p>
          <p class="text-sm text-gray-600 mt-2">Pages légales et politique de confidentialité incluses.</p>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
