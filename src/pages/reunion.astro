---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<html lang="fr">
  <head>
    <Head title="Compte-rendu de réunion — Mirosotech" description="Transcription et génération de compte-rendu structuré de réunion. Décisions, actions, responsables." />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <Header />

    <section class="bg-primary text-white py-20 px-6 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
        Compte-rendu de réunion
      </h1>
      <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto opacity-90">
        Transcription et compte-rendu structuré de vos réunions.<br />
        Décisions, actions, responsables, échéances.
      </p>
      <a href="/contact" class="bg-accent text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-blue-700 transition">
        Demander un devis
      </a>
    </section>

    <section class="py-16 px-6 max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">Ce qui est inclus</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
          <h3 class="text-xl font-bold mb-3">📝 Transcription fidèle</h3>
          <p class="text-gray-600">Reprise intégrale des échanges.</p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
          <h3 class="text-xl font-bold mb-3">🎯 Synthèse des décisions</h3>
          <p class="text-gray-600">Ce qui a été décidé, par qui.</p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
          <h3 class="text-xl font-bold mb-3">✅ Plan d'actions</h3>
          <p class="text-gray-600">Tâches, responsables, échéances.</p>
        </div>
      </div>
    </section>

    <section class="py-16 px-6 max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100">
      <div class="text-center mb-12">
        <h3 class="text-2xl font-bold mb-4">Exemple de structure livrée</h3>
      </div>
      <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 font-mono text-sm">
        <p class="font-bold mb-2">Réunion du 05 novembre 2026 — 14h00</p>
        <p class="mb-2"><span class="font-bold">Participants :</span> Liva, Sophie, Marc</p>
        <p class="mb-2"><span class="font-bold">Décisions :</span> Lancement du projet miroso.tech validé.</p>
        <p class="mb-2"><span class="font-bold">Actions :</span></p>
        <ul class="list-disc list-inside mb-2">
          <li>Création du site portfolio — Liva — 15/11</li>
          <li>Déploiement Netlify — Sophie — 20/11</li>
        </ul>
      </div>
    </section>

    <section class="py-16 px-6 max-w-4xl mx-auto">
      <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
        <h3 class="text-xl font-bold mb-6">🔒 Confidentialité des réunions</h3>
        <p class="text-gray-600 mb-4">
          Vos enregistrements de réunions sont confidentiels. Conformité RGPD. Suppression sécurisée après livraison du compte-rendu.
        </p>
        <ContactForm />
      </div>
    </section>

    <Footer />
  </body>
</html>
