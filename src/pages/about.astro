---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="fr">
  <head>
    <Head title="À propos — Liva Randrianivoson, développeur freelance | Mirosotech" description="Qui suis-je ? Liva Randrianivoson, développeur freelance spécialisé dans la création de sites vitrines statiques." />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <Header />

    <section class="py-16 px-6 max-w-4xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="lg:w-1/3">
          <div class="w-48 h-48 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 font-bold text-xl mx-auto lg:mx-0 mb-6 lg:mb-0">
            LR
          </div>
        </div>
        <div class="lg:w-2/3">
          <h2 class="text-3xl font-bold mb-6">Bonjour, je suis Liva</h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            Développeur freelance basé à Madagascar, je crée des <strong>sites vitrines statiques</strong> pour les artisans, commerçants et indépendants qui veulent être visibles en ligne sans complexe technique.
          </p>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            Mon approche est simple : un site léger, rapide sur mobile, sécurisé, et facile à trouver sur Google. Pas d'abonnement mensuel, pas de base de données à gérer. Vous payez une fois, et votre site reste en ligne.
          </p>
        </div>
      </div>

      <section class="mt-16 bg-white p-8 rounded-xl shadow-sm border border-gray-100">
        <h3 class="text-xl font-bold mb-6">Pourquoi le statique ?</h3>
        <ul class="space-y-4 text-gray-600">
          <li>⚡ <strong>Rapide :</strong> chargement immédiat pour vos clients.</li>
          <li>🔒 <strong>Sécurisé :</strong> pas de base de données à pirater.</li>
          <li>💰 <strong>Économique :</strong> hébergement gratuit ou très peu coûteux.</li>
          <li>🔍 <strong>SEO :</strong> Google apprécie les sites statiques bien structurés.</li>
        </ul>
      </section>
    </section>

    <Footer />
  </body>
</html>
